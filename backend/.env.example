# Gray Matter backend - copy to backend/.env and fill in.
#
# Every value here has a working default. With no .env at all the API serves
# the seeded NovaPay graph and composes answers from retrieved evidence.

# -- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- LLM / Cognee -----------------------------------------------------------
# Without a key the service still answers; the prose is composed extractively
# from the retrieved sources instead of being phrased by a model.
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.6-flash

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Master switch for the Cognee engine. Off means it is never imported.
USE_COGNEE=true

# Let the model phrase /ask answers over retrieved evidence. Structured fields
# are graph-derived either way.
# Off until the Cognee graph has been built. Cognee's search raises a
# precondition error until `python scripts/cognify.py` has run, and
# retrying it costs seconds per question for a result that is
# discarded. Answers are composed from retrieved evidence meanwhile.
USE_LLM_ANSWERS=false

# Seconds to wait on Cognee before falling back to the deterministic path.
COGNEE_TIMEOUT_S=12
